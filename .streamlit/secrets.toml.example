# Copy this file to .streamlit/secrets.toml and fill it in. Never commit secrets.toml.
# Create the OAuth app at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App

[github]
client_id = ""
client_secret = ""
# Must exactly match the "Authorization callback URL" in your GitHub OAuth app.
redirect_uri = "http://localhost:8501"
# GitHub usernames allowed to use the app (case-insensitive).
allowed_users = ["your-github-username"]
# Anyone can sign in, but must star owner/repo and follow owner to get in.
# The owner and allowed_users skip the check. Set to false to allow only allowed_users.
owner = "your-github-username"
repo = "writelens"
require_star_follow = false

# Optional AI engine. Leave this section out and every tool runs offline (status light grey).
# Providers are tried in this order: OpenRouter, then Gemini, then Groq.
# On OpenRouter also turn on Settings -> Privacy -> "Allow free endpoints that train on request data".
[ai]
openrouter_key = ""   # free: openrouter.ai -> Keys
# gemini_key = ""     # free: aistudio.google.com -> Get API key
# groq_key = ""       # free: console.groq.com -> API Keys
daily_limit = 30      # AI checks per user per day
# Pick your own models instead of the automatic list of free ones, e.g.:
# openrouter_models = ["meta-llama/llama-3.3-70b-instruct:free"]
